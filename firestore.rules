rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the designated Firebase Authentication user may access inventory data.
    match /lager/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == 'BBCxx0KUpJUzqxTTJdGgHfvk5cN2';
    }
    // Deny all other documents, including accidental test collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
